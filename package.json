{
  "name": "all-updater",
  "private": true,
  "version": "1.0.10",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:ui": "cross-env ALL_UPDATER_SKIP_ELEVATION=1 vite",
    "build": "npm run build:portable",
    "build:unsigned": "npm run build:portable",
    "build:local": "npm run build:portable",
    "build:portable": "tsc -b && vite build && electron-builder --win portable",
    "build:portable:unsigned": "npm run build:portable",
    "package:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/release/package-portable.ps1",
    "package:portable:unsigned": "npm run package:portable",
    "release:local": "npm run build:portable",
    "release:portable": "npm run build:portable && npm run package:portable",
    "release:github": "npm run release:portable && powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/release/publish-release.ps1",
    "release:portable:unsigned": "npm run release:portable",
    "release:portable:unsigned:github": "npm run release:github",
    "signing:check": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/release/check-signing-env.ps1",
    "build:portable:signed": "npm run signing:check && tsc -b && vite build && electron-builder --win portable --config.forceCodeSigning=true",
    "signing:verify-artifact": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/release/verify-signature.ps1",
    "release:portable:signed": "npm run build:portable:signed && npm run signing:verify-artifact",
    "release": "npm run release:portable",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck:app": "tsc -p tsconfig.app.json --noEmit",
    "typecheck:electron": "tsc -p tsconfig.electron.json --noEmit",
    "test": "npm run test:unit",
    "test:unit": "tsc -p tsconfig.tests.json && node --experimental-specifier-resolution=node ./scripts/test/run-unit-tests.mjs unit",
    "test:integration": "tsc -p tsconfig.tests.json && node --experimental-specifier-resolution=node ./scripts/test/run-unit-tests.mjs integration",
    "verify": "npm run lint && npm run typecheck:app && npm run typecheck:electron",
    "test:regression": "npm run verify && npm run test:unit && npm run test:integration"
  },
  "build": {
    "appId": "com.antigravity.allupdater",
    "productName": "All Updater",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist",
      "dist-electron"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "${productName}-${version}.${ext}",
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "portable": {
      "requestExecutionLevel": "admin"
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "electron-log": "^5.4.3",
    "electron-store": "^11.0.2",
    "execa": "^9.6.1",
    "fix-path": "^5.0.0",
    "framer-motion": "^12.34.0",
    "lucide-react": "^0.563.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.24",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^40.4.0",
    "electron-builder": "^26.7.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "wait-on": "^9.0.3"
  }
}
